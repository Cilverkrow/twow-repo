# Build context trimming. The core build needs source, cmake, deps and .git
# (for the revision header); it does not need 189MB of SQL, 24MB of runbook
# evidence, or any local build tree.
runbooks/
sql/
docs/
patches/
ops/
**/build/
**/.vs/
**/CMakeCache.txt
**/CMakeFiles/
*.log

# ci.yml artefacts. The staged install (./stage) is deliberately NOT here - the
# ci-staged target COPYs it - but everything else the build job leaves behind is
# large and would only slow the context transfer down.
.ccache/
.sccache/
.vcpkg-cache/
.ci/
test-results/
image/
