# Copy to deploy/compose/.env and edit. .env is gitignored and must stay that way:
# it holds the database credentials the whole stack runs on.
#
#     cp deploy/compose/.env.example deploy/compose/.env

# --- credentials ------------------------------------------------------------
# No defaults on purpose. The stack refuses to start without them rather than
# coming up with a guessable password.
DB_ROOT_PASSWORD=change-me-root
DB_USER=turtle
DB_PASSWORD=change-me-app

# --- exposure ---------------------------------------------------------------
# Loopback by default. A world server on 0.0.0.0 is reachable from the internet
# the moment the host is; set this only when you mean to serve a LAN, and put a
# firewall in front of it.
BIND_ADDR=127.0.0.1
# The database is bound separately so opening the game ports does not open 3306.
DB_BIND_ADDR=127.0.0.1

REALM_PORT=3724
WORLD_PORT=8090
DB_PORT=3306
ADMINER_PORT=8080

# --- realm ------------------------------------------------------------------
# Written into tw_logon.realmlist by db-init. REALM_ADDRESS must be the address
# clients dial, i.e. what goes in their realmlist.wtf -- not "db", not a
# container name. WORLD_PORT must match WorldServerPort, or login succeeds and
# the client then hangs before character select.
REALM_NAME=TurtleWoW
REALM_ADDRESS=127.0.0.1

# --- paths ------------------------------------------------------------------
# Client data: dbc/ maps/ vmaps/ mmaps/. Extracted from a Turtle WoW 1.18.1
# (build 7272) client with `make extract`; never committed, never in an image.
DATA_PATH=./data
# Only needed for `make extract`: an installed game client directory.
CLIENT_PATH=./client

# sql/base (190 files, ~130 MB of world content) moves to the upstream repo
# later (ADR-0020). When it does, repoint SQL_BASE_PATH and leave SQL_PATH alone.
SQL_PATH=../../sql
SQL_BASE_PATH=../../sql/base
PLAYERBOTS_SQL_PATH=../../src/modules/PlayerBots/sql

# --- build / runtime --------------------------------------------------------
IMAGE_REPO=twow/core
IMAGE_TAG=dev
# x86-64-v2, not native: a native build runs only on the machine that built it.
TW_ARCH=x86-64-v2
# OFF gives a server with no bots and no warning anywhere.
BUILD_PLAYERBOTS=ON

DB_BUFFER_POOL=1G
# Seconds the entrypoint waits for the in-game shutdown to finish. Keep it well
# under docker-compose.yml's stop_grace_period (180s).
MANGOSD_SHUTDOWN_GRACE=120

# --- first-run tuning -------------------------------------------------------
# A thousand bots are created and geared before the world finishes coming up.
# Raise once the server is known good.
AIPLAYERBOT_MIN_BOTS=10
AIPLAYERBOT_MAX_BOTS=10
