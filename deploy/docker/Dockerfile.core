# syntax=docker/dockerfile:1.7
#
# Tortoise-WoW core (mangosd + realmd), Linux build.
#
# Four things about this file are load-bearing and easy to get wrong:
#
# 1. CMAKE_INSTALL_PREFIX is identical in both stages. The prefix is compiled
#    into the binary (SYSCONFDIR, see CMakeLists.txt), so building under /build
#    and copying to /opt/turtle produces a server that silently cannot find its
#    own configs -- no error, just missing features. Build where you will run.
#
# 2. TW_ARCH defaults to x86-64-v2 rather than the historical `native`, so the
#    image runs on machines other than the one that built it.
#
# Client data (dbc/maps/vmaps/mmaps) is deliberately NOT in this image. It is
# extracted from a game client and mounted at runtime.
#
# STAGE LAYOUT. The apt layers are split out of the two interesting stages
# (`builder-base` and `runtime-base`) so that ci.yml can reuse them without
# copying their package lists into a second file. A copied package list drifts:
# the day somebody adds a runtime library here, a CI-only duplicate would still
# be building the old image and the smoke job would stop exercising what ships.
# There is exactly one apt list per stage and both workflows read it from here.
#
#   builder-base --> builder ----+------> debug-symbols (FROM scratch, never
#                                 \                      deployed, see below)
#   runtime-base --> runtime <----+  (publish.yml, nightly, `--target runtime`)
#                \
#                 -> ci-staged      (ci.yml only, see below)
#
# 3. BUILD CONFIGURATION PARITY (#486 B4). The builder stage below and ci.yml's
#    build-and-test configure the shipped targets identically, so the image CI
#    assembles (ci-staged) and the image built here (runtime) are the same
#    build and the CI image can be promoted instead of rebuilt:
#      CMAKE_BUILD_TYPE=Release, CMAKE_INSTALL_PREFIX=/opt/turtle,
#      TW_ARCH=x86-64-v2, MODULES=static, DEBUG_SYMBOLS=OFF,
#      CMAKE_C_FLAGS=-g1, CMAKE_CXX_FLAGS=-g1,
#    then `cmake --install` and deploy/docker/split-debug.sh.
#    ops/ci/test-image-build-parity.sh fails when the two drift apart.
#
#    ci.yml additionally sets BUILD_TESTING=ON and
#    BUILD_PERSISTENT_ROSTER_ADAPTER_TESTS=ON. Those only ADD test targets:
#    their compile flags are PRIVATE to the test targets, no test target has an
#    install() rule and googletest is fetched with INSTALL_GTEST=OFF, so the
#    installed tree is the same. Measured on commit 048788cf: CI (tests ON,
#    run 37044803296) and publish (tests OFF, run 37044803023) installed the
#    same 19 paths, no test binary among them.
#
# 4. DEBUG INFORMATION (#486, owner decision 2b). Compiled with -g1 and split:
#    split-debug.sh moves the DWARF into separate .debug files that end up in
#    the `debug-symbols` stage and in a CI/publish artifact, never in a layer of
#    the runtime image. The installed binaries keep .symtab and a
#    .gnu_debuglink to their .debug file.
#
#    Why -g1 and not -g: -g1 keeps function descriptions and line tables -
#    enough for a symbolised backtrace with file:line from a crash or a core
#    dump - and drops the type and local-variable DWARF that makes up most of
#    a -g build (the -g image carried ~1 GB of it, 94% of the payload). The
#    debug flags are part of every compile line and so of every ccache entry:
#    full -g objects would not fit the repository's 10 GB Actions cache next to
#    everything else (ci.yml's ccache was already 4.1/4.0 GB full without any
#    debug info). DEBUG_SYMBOLS=OFF is required alongside: the core's switch
#    appends a plain -g after these flags, and the last -g level wins.
#    GCC's contract is that debug options do not change the generated code
#    (-fcompare-debug exists to check it), so the shipped machine code is that
#    of a build without debug information.

ARG DEBIAN_VERSION=trixie
ARG PREFIX=/opt/turtle

# ------------------------------------------------------------ builder-base
#
# The compile toolchain, and nothing that depends on the source tree. Kept as
# its own stage because ci.yml runs its build in a container made from exactly
# this image: same Debian, same gcc, same libace/libmariadb sonames as the
# runtime stage below. Building the server on the runner's Ubuntu instead would
# link against libACE-7.1.3 and libmysqlclient.so.21, neither of which exists in
# a trixie runtime -- the binaries would install fine and fail to exec.
#
# python3 is here for ops/audit/extract_compile_flags.py, which the header
# self-containment audit runs off this build's compile_commands.json. It costs
# nothing that ships: this stage is discarded, only ${PREFIX} is copied out.
FROM debian:${DEBIAN_VERSION}-slim AS builder-base
# ca-certificates is in that list deliberately, and is not optional even though
# the from-source builder never needed it. That path does COPY . /src and clones
# nothing; a BUILD_TESTING=ON configure FetchContent-clones googletest over
# https, and without the CA bundle git fails three times with "Problem with the
# SSL CA cert (path? access rights?)" and cmake gives up. This has now cost two
# separate debugging sessions, in a container and in CI.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git ccache python3 \
      ca-certificates \
      libace-dev default-libmysqlclient-dev \
      libssl-dev zlib1g-dev libbz2-dev \
      libboost-dev libboost-thread-dev libboost-filesystem-dev \
      libboost-system-dev libboost-stacktrace-dev \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------- builder
#
# The from-source build. publish.yml and nightly.yml go through here; ci.yml no
# longer does, because a BuildKit cache mount cannot be exported by type=gha and
# so this stage recompiled all ~1200 translation units on every push.
FROM builder-base AS builder
ARG PREFIX
ARG TW_ARCH=x86-64-v2
# static, dynamic or disabled. Applies to every module under modules/,
# mod-playerbots included.
ARG MODULES=static
ARG BUILD_TYPE=Release
# Ninja parallelism for the compile below.
#
# THE DEFAULT IS A NUMBER, NOT `nproc`, AND THAT IS THE POINT. This line used to
# be `--parallel "$(nproc)"`, and an earlier attempt at capping it left `nproc`
# as the fallback for an unset ARG - which is the same bug with an extra step,
# because the fallback is what actually runs whenever a caller forgets to pass
# the arg.
#
# `nproc` is not cgroup-aware. On the CI pod it returns the NODE's 20 CPUs while
# the memory actually available is ~9.2 GiB, and the heavy translation units in
# this tree peak at 1.5-2.5 GiB each. 20 concurrent g++ against that ceiling is
# an OOM kill, and BuildKit reports it as
#
#     failed to receive status: rpc error: code = Unavailable
#     desc = error reading from server: EOF
#
# i.e. buildkitd itself disappearing - which names neither memory nor this line.
# That is exactly what happened after 139 of 1472 targets.
#
# This is the one compile in the pipeline that happens inside BuildKit rather
# than on the runner, so the workflow cannot cap it from outside; the cap has to
# be here. nightly.yml and publish.yml pass BUILD_JOBS explicitly.
#
# Building this by hand on a machine with memory to spare? Ask for it:
#     docker build --build-arg BUILD_JOBS=$(nproc) ...
ARG BUILD_JOBS=4

WORKDIR /src
# The whole context, core/ submodule included. There is no separate COPY for it
# and there must not be: the submodule is an ordinary directory on disk once the
# checkout is recursive, and `COPY core /src/core` would only paper over a
# non-recursive one. What a non-recursive checkout gets instead is the
# FATAL_ERROR in the root CMakeLists, which names the command to run.
#
# Recursive has to mean two levels here: core/ carries the Eluna engine as a
# submodule of its own at core/src/modules/Eluna, and BUILD_ELUNA defaults ON,
# so a one-level checkout dies in the core's own FATAL_ERROR instead.
#
# .git comes along too, and is needed: the revision header is produced by
# running git inside /src/core, whose .git is a file pointing at
# /src/.git/modules/core.
COPY . /src

# The debug flags are literals, not ARGs, on purpose: they are half of the
# parity contract with ci.yml (note 3 at the top), and a build-arg would let a
# caller produce a "runtime" image that is no longer the build CI tested.
RUN --mount=type=cache,target=/ccache \
    CCACHE_DIR=/ccache cmake -S /src -B /build -G Ninja \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DCMAKE_INSTALL_PREFIX=${PREFIX} \
      -DTW_ARCH=${TW_ARCH} \
      -DMODULES=${MODULES} \
      -DDEBUG_SYMBOLS=OFF \
      -DCMAKE_C_FLAGS=-g1 \
      -DCMAKE_CXX_FLAGS=-g1 \
      -DCMAKE_C_COMPILER_LAUNCHER=ccache \
      -DCMAKE_CXX_COMPILER_LAUNCHER=ccache

# /debug-symbols is outside ${PREFIX} deliberately: the runtime stage copies the
# whole prefix, and only the debug-symbols stage below reads /debug-symbols.
RUN --mount=type=cache,target=/ccache \
    CCACHE_DIR=/ccache cmake --build /build --parallel "${BUILD_JOBS}" \
    && cmake --install /build \
    && bash /src/deploy/docker/split-debug.sh "${PREFIX}" /debug-symbols

# ------------------------------------------------------------ runtime-base
#
# Everything about the shipped image except where ${PREFIX} came from: the apt
# list, the entrypoint, the unprivileged user, the data directories, the ports.
# The two stages below differ in one COPY and nothing else, which is the point -
# the CI image and the released image are the same image with a different
# provenance for the same tree of files.
FROM debian:${DEBIAN_VERSION}-slim AS runtime-base
ARG PREFIX
ENV PREFIX=${PREFIX}

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      libace-8.0.2 libmariadb3 libssl3 zlib1g libbz2-1.0 \
      libboost-system1.83.0 libboost-thread1.83.0 libboost-filesystem1.83.0 \
      mariadb-client tini \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/docker/entrypoint-mangosd.sh /usr/local/bin/entrypoint-mangosd.sh
# The uid and the gid are pinned, and that is load-bearing rather than tidiness.
#
# The compose file bind-mounts host-rendered configs (deploy/compose/config/
# *.conf) over /opt/turtle/etc/*.conf. Those files carry the database password in
# cleartext -- the server does no environment substitution -- so they are not
# world-readable, which means the host has to grant read access to a *specific*
# identity before the container starts. `useradd --system` with no --uid takes
# the highest free system uid at image build time: 999 today, 998 the day an apt
# package claims an account ahead of it, something else again on another Debian
# point release. An identity that moves cannot be granted anything in advance,
# so realmd ran as a uid nothing on the host had ever heard of, could not open
# its own config, and mangos reported that as "Could not find configuration file
# /opt/turtle/etc/realmd.conf" -- a permission failure wearing a missing-file
# message. It crash-looped on exactly this the first time the CI smoke job
# actually ran.
#
# render-config.sh grants read to uid 10001; this line is the other half of that
# agreement. Change one of the two numbers and you must change the other.
#
# 10001 rather than something low: above the 0-999 range Debian hands to system
# accounts, and above the 1000-1999 band that desktop logins and CI runners (the
# GitHub runner is uid 1001) sit in, so it collides with nothing that already
# exists on a host whose files this container is about to be handed.
#
# Changing this number on an existing deployment orphans the `server-logs`
# volume: Docker takes a named volume's ownership from the image directory the
# first time it is mounted, so a volume created by an older image is still owned
# by that older uid and the new one cannot write logs into it. `docker volume rm
# twow_server-logs` (or `make clean`) is the fix; nothing but logs is lost.
RUN chmod +x /usr/local/bin/entrypoint-mangosd.sh \
    && groupadd --system --gid 10001 turtle \
    && useradd --system --uid 10001 --gid 10001 \
         --create-home --home-dir /home/turtle turtle \
    && mkdir -p /data /var/log/turtle ${PREFIX}/run \
    && chown -R turtle:turtle /data /var/log/turtle ${PREFIX}/run

# WORKDIR before USER on purpose: it creates ${PREFIX}/bin, and that directory
# was root-owned when the COPY below created it, so it stays root-owned.
WORKDIR ${PREFIX}/bin
EXPOSE 8090 3724
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-mangosd.sh"]
USER turtle

# ---------------------------------------------------------------- runtime
#
# The released image. `--target runtime` is what publish.yml builds and what the
# compose file and the Helm chart address.
FROM runtime-base AS runtime
ARG PREFIX
COPY --from=builder ${PREFIX} ${PREFIX}

# The unprivileged entrypoint seeds each required module .conf next to its
# root-owned .conf.dist template on first start.  Keep the installed payload
# immutable, but hand ownership of that one directory to the runtime account so
# creating the missing files does not crash-loop mangosd before it reaches the
# database.
USER root
RUN if [ -d "${PREFIX}/etc/modules" ]; then \
      chown turtle:turtle "${PREFIX}/etc/modules"; \
    fi
USER turtle

# ----------------------------------------------------------- debug-symbols
#
# NEVER DEPLOYED. The DWARF split-debug.sh moved out of the installed binaries,
# as a filesystem-only stage: ${PREFIX}/<path>.debug (the install path
# mirrored, gdb's debug-file-directory layout) plus BUILD-IDS.
# publish.yml exports it with `--target debug-symbols` and a `type=local`
# output and uploads it as an artifact; that second build reuses the builder
# stage from the same job, it does not compile again.
#
# FROM scratch so nothing can run it and nothing mistakes it for an image to
# deploy. The runtime stage above never references it (owner decision 2b: the
# symbols are a separate artifact, never a layer of the runtime image).
FROM scratch AS debug-symbols
COPY --from=builder /debug-symbols /

# --------------------------------------------------------------- ci-staged
#
# CI ONLY. Never published, never referenced by publish.yml or nightly.yml.
#
# Identical to `runtime` except that ${PREFIX} comes from the build context
# instead of from the builder stage. ci.yml produces that directory by running
# `cmake --install` inside a container made from `builder-base`, which is the
# same compiler and the same libraries the builder stage would have used - so
# the resulting image is byte-comparable in everything except how the files got
# there, and the smoke job still exercises a realistic artefact.
#
# What this target does NOT prove is that `--target runtime` still builds: that
# the COPY . /src, the in-Dockerfile configure and the in-Dockerfile build all
# work. nightly.yml and publish.yml cover it. See the long comment on the image
# steps in ci.yml.
FROM runtime-base AS ci-staged
ARG PREFIX
# Relative to the build context. ci.yml stages into ./stage.
ARG STAGE=stage
COPY ${STAGE} ${PREFIX}

# Keep the staged CI image's runtime contract identical to the released image.
USER root
RUN if [ -d "${PREFIX}/etc/modules" ]; then \
      chown turtle:turtle "${PREFIX}/etc/modules"; \
    fi
USER turtle
