# Build trees and generated output
/build/
/bin/
/out/
/cmake-build-*/
/samples/
/src/shared/revision.h
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Live server, database, client data, and logs
/server/
/DB/
/data/
/logs/
/vcpkg/
*.pid
*.log
*.log.*
*.dmp
# Core dumps. Anchored to a bare filename rather than a suffix: the old `*.core`
# also matched deploy/docker/Dockerfile.core, so the Dockerfile was silently
# never committed and CI could not build the image.
core
core.[0-9]*

# Compiled or otherwise binary artifacts
*.exe
*.dll
*.so
*.dylib
*.lib
*.a
*.obj
*.o
*.pch
*.pdb
*.ilk
*.exp
*.aps
*.class
*.jar
*.bin
*.dat
*.key
*.cr
*.ico
*.bmp
*.png
*.jpg
*.jpeg
*.gif

# Archives and packaged deliverables
*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz

# WoW/client/server runtime assets
*.mpq
*.dbc
*.map
*.vmap
*.mmap
*.mmtile
*.m2
*.wmo
*.blp

# Secrets and machine-local configuration
.env
.env.*
!.env.example
*.conf
!*.conf.dist
!*.conf.dist.in
!*.conf.example
!*.example.conf
*.pem
*.pfx
*.p12
*.keystore
credentials.json
secrets/
**/secrets/

# Database runtime state and dumps
*.ibd
*.MYD
*.MYI
*.frm
ibdata*
ib_logfile*
aria_log*
*.sql.gz
*.dump

# Runbook payloads that are evidence packages, not source
runbooks/**/artifacts/candidate/
runbooks/**/artifacts/production/
runbooks/**/*.base64
runbooks/**/*.base64.*

# Local backup copies made before editing
*.bak
*.bak.*
*.bak-*
*~

# Editors and operating systems
/.vscode/
/.vs/
/.idea/
*.kate-swp
*.swp
.DS_Store
Thumbs.db

# ci.yml working directories: the staged install, the compiler and dependency
# caches, and the small files the cache keys are hashed from. All are produced
# inside a run and none of them belongs in the tree (ADR-0004).
/stage/
/.ccache/
/.sccache/
/.vcpkg-cache/
/.ci/
/image/
/test-results/
