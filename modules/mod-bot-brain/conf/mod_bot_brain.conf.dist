[worldserver]

########################################
# mod-bot-brain
#
# Asks an out-of-process planner (services/bot-brain) where a bot should travel
# next, and applies the answer through the existing travel-target chooser.
# See ADR-0012.
#
# Two things must both be true for a bot to be planned for:
#   1. BotBrain.Enable = 1 below, and a handshake with the service succeeded
#      (matching contract major). This is attempted at startup and retried
#      every BotBrain.BackoffMs, so the service may start in either order;
#   2. the bot carries the "bot brain" non-combat strategy -- append
#      ",+bot brain" to AiPlayerbot.RandomBotNonCombatStrategies.
#
# Everything degrades to the stock chooser, silently: no service, a slow
# service, a version-skewed service, an expired intent or an unknown POI all
# leave the bot travelling exactly as it does with this module off. Killing the
# service is a supported operation, not an outage.
########################################

# Off by default. The core must run with every project feature disabled
# (ADR-0024 invariant 4).
BotBrain.Enable = 0

# Scheme, host and port of the planner. It listens on loopback by default and
# there is no reason to point this off-host without a deliberate decision:
# snapshots carry character names and positions.
BotBrain.Endpoint = "http://127.0.0.1:8085"

# How long the worldserver waits for one plan. Sent to the service as
# deadline_ms so it sheds rather than hangs, and used as the socket timeout so
# a wedged service costs a worker thread instead of a bot.
BotBrain.TimeoutMs = 750

# Minimum gap between plan requests for one bot. This is a slow decision loop:
# seconds, not ticks. Lower values cost one GetPartitions call and one HTTP
# round trip per bot per interval.
BotBrain.IntervalMs = 15000

# Per-bot pause after a failed or unusable round trip.
#
# Also the retry interval for the startup handshake. If the service is not
# up when the worldserver starts, the module retries in the background at
# this cadence and logs once when it recovers, so start order does not
# matter and restarting the service does not require restarting the realm.
BotBrain.BackoffMs = 60000

# How long a partially-filled batch waits for more snapshots before it is sent
# anyway. Snapshots accumulate until either MaxBatch is reached or this
# deadline elapses, so it is the ceiling on how long one bot's request waits
# for its neighbours. Lower means fresher plans and more round trips; higher
# means fuller batches and staler positions.
#
# Clamped to 10..10000. The module read this key from the first batching
# commit but the template never documented it, so an operator could not
# discover or set it -- a default that could only be changed by reading the
# source is not really a setting.
BotBrain.BatchFlushMs = 200

# Ceiling on concurrent worker threads across all bots. A service that stops
# answering must cost a bounded number of threads.
BotBrain.MaxInFlight = 8

# How many points of interest one snapshot carries, nearest first.
BotBrain.MaxPois = 24

# How long a POI table stays resolvable after the snapshot that built it. POI
# ids are snapshot-scoped by contract; an intent naming an older one is a stale
# destination and is dropped.
BotBrain.PoiTableTtlMs = 120000

# Log every applied intent (intent id and POI id) at BASIC level. On by
# default: "a bot's travel target was set from an intent" is only checkable if
# it is written down.
BotBrain.LogAppliedIntents = 1

###############################################################################
# Dialogue -- bots answering chat
###############################################################################
#
# A bot with the "ai chat" strategy that is spoken to in say, yell, party,
# raid, guild or a whisper asks the brain what to answer, and says it. The
# reply is written from the bot's personality profile (its trait_keys resolve
# to the catalog's instruction sentences), in German, and it is TEXT: a reply
# cannot invite, trade, group or act.
#
# This needs the core-side gates too, and they are separate switches owned by
# mod-playerbots, not by this module:
#
#   AiPlayerbot.LLMEnabled           must be non-zero (it defaults to 0)
#   the bot needs the "ai chat" strategy, or LLMEnabled = 3
#   AiPlayerbot.LLMBlockedReplyChannels still applies
#
# Nothing here overrides those. This decides where the sentence comes from,
# not who is allowed to speak.

# Off by default, separately from BotBrain.Enable, and deliberately so:
# planning is local and free, while dialogue spends model tokens every time a
# player types. Enabling the brain is not agreeing to pay for conversation.
BotBrain.Dialogue.Enable = 0

# How long one dialogue call may take, in milliseconds. Clamped to
# 1000..60000.
#
# Much larger than BotBrain.TimeoutMs, because the thing on the far end is a
# model rather than a planner: a self-hosted 7B on CPU measured around eight
# seconds a call. That is affordable here and nowhere else in this module,
# because the call is made from the chat path's own async worker -- the world
# thread never waits for it, and the reply is posted on the bot's next tick
# after it lands.
#
# Sent to the service as deadline_ms as well as used as the socket timeout, so
# a brain under load answers with silence instead of being hung up on.
BotBrain.Dialogue.TimeoutMs = 8000

# Ceiling on concurrent dialogue calls across all bots. Clamped to 1..64.
#
# Each in-flight call holds a worldserver worker thread that the chat path
# spawned for that message, so this bounds threads, not just politeness towards
# the model. Over the limit a bot is silent immediately rather than queued: a
# queue here would accumulate load during exactly the incident where
# accumulating it is fatal.
BotBrain.Dialogue.MaxInFlight = 8
