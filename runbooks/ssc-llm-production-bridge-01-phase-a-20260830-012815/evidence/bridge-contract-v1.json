  "request_envelope": {
    "exact_fields": ["schema_version", "request_id", "bot_guid", "created_utc", "expires_utc", "message"],
    "schema_version": 1,
    "request_id": "canonical lowercase RFC 4122 UUIDv4",
    "bot_guid": "integer 1..4294967295; V1 pin 18281",
    "created_utc": "canonical YYYY-MM-DDTHH:mm:ss.sssZ",
    "expires_utc": "canonical YYYY-MM-DDTHH:mm:ss.sssZ; after creation",
    "message": "nonempty strict UTF-8; no U+0000..U+001F or U+007F; max 2048 bytes"
  },
  "commands": {
    "submit": {
      "wire": {"command": "submit", "request": "<request_envelope>"},
      "response_exact_fields": ["accepted", "code", "status"],
      "result_codes": ["queued", "duplicate", "identity_mismatch", "queue_full", "expired", "ledger_full"]
    },
    "status": {
      "wire_exact_fields": ["command", "request_id", "bot_guid"],
      "response_exact_fields": ["code", "status"],
      "result_codes": ["ok", "not_found", "identity_mismatch"]
    },
    "consume": {
      "wire_exact_fields": ["command", "request_id", "bot_guid"],
      "response_exact_fields": ["code", "status", "completion"],
      "result_codes": ["not_ready", "consumed", "already_consumed", "not_found", "identity_mismatch"]
    },
    "metrics": {
      "wire": {"command": "metrics"},
      "response_exact_fields": ["code", "metrics"]
    },
    "shutdown": {
      "wire_exact_fields": ["command", "drain"],
      "required_v1_wire": {"command": "shutdown", "drain": true},
      "response_exact_fields": ["code", "metrics"]
    }
  },
  "status_envelope": {
    "exact_fields": ["schema_version", "request_id", "bot_guid", "state", "queued_utc", "updated_utc", "attempt_count", "error_code"],
    "schema_version": 1,
    "states": ["queued", "running", "ready", "failed", "expired", "consumed"],
    "attempt_count": [0, 1]
  },
  "completion_envelope": {
    "exact_fields": ["schema_version", "request_id", "bot_guid", "outcome", "model", "attempt_count", "started_utc", "completed_utc", "text", "error_code", "raw_response_bytes"],
    "schema_version": 1,
    "outcomes": ["ready", "failed", "expired"],
    "ready_invariants": ["model=qwen2.5:7b", "attempt_count=1", "text is nonempty canonical sanitized text", "error_code=null", "raw_response_bytes is integer 0..65536"],
    "nonready_invariants": ["text=null", "error_code is nonempty", "no delivery"]
  },
  "metrics_fields": ["lifecycle", "accepting", "waiting", "ledger_entries", "active", "max_active_observed", "inference_attempts", "stale_results_discarded", "worker_owned", "worker_settled"],
  "identity_and_lifetime": {
    "key": ["request_id", "bot_guid"],
    "wire_utc_preserved": true,
    "bridge_deadline": "admission_monotonic + (expires_utc - admission_wall), derived once",
    "core_deadline": "steady_clock deadline derived once at request creation",
    "duplicate_replaces_deadline": false,
    "retry_or_resubmit": false,
    "consume_once": true,
    "late_or_stale_text_delivered": false
  },
  "core_delivery_contract": {
    "allowed": "one direct whisper after world-thread identity/session/target revalidation",
    "forbidden": ["bot action", "emote", "server command", "admin command", "chat command parsing", "public channel", "bot-to-bot", "RPG/NPC dialogue", "direct Ollama access"]
  }
