{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ssc://phase1a/status-envelope-v1",
  "title": "SSC Phase 1A immutable lifecycle status envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "bot_guid",
    "state",
    "queued_utc",
    "updated_utc",
    "attempt_count",
    "error_code"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "bot_guid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "state": { "enum": ["queued", "running", "ready", "failed", "expired", "consumed"] },
    "queued_utc": { "$ref": "#/$defs/timestamp" },
    "updated_utc": { "$ref": "#/$defs/timestamp" },
    "attempt_count": { "type": "integer", "minimum": 0, "maximum": 1 },
    "error_code": { "type": ["string", "null"], "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["queued", "running", "ready"] } }, "required": ["state"] },
      "then": { "properties": { "error_code": { "type": "null" } } }
    },
    {
      "if": { "properties": { "state": { "enum": ["failed", "expired"] } }, "required": ["state"] },
      "then": { "properties": { "error_code": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "state": { "const": "queued" } }, "required": ["state"] },
      "then": { "properties": { "attempt_count": { "const": 0 } } }
    },
    {
      "if": { "properties": { "state": { "enum": ["running", "ready"] } }, "required": ["state"] },
      "then": { "properties": { "attempt_count": { "const": 1 } } }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
