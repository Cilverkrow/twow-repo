{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ssc://phase1a/request-envelope-v1",
  "title": "SSC Phase 1A immutable request envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "bot_guid",
    "created_utc",
    "expires_utc",
    "message"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "bot_guid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "created_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expires_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 2048 }
  }
}
